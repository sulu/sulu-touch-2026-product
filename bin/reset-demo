#!/usr/bin/env bash
# Rebuilds the data of the checked out step from scratch: schema, admin user and, from step 3, the catalogue.
# Safe to run at every step. The server keeps running: the caches are cleared at the end.
set -euo pipefail
cd "$(dirname "$0")/.."

rm -rf var/uploads var/indexes public/uploads/media
bin/adminconsole doctrine:schema:drop --full-database --force --no-interaction >/dev/null 2>&1 || true
bin/adminconsole doctrine:database:create --if-not-exists
bin/adminconsole doctrine:schema:create
bin/adminconsole sulu:build dev --no-interaction

# the OAuth key pair of the MCP server (step 8): not in git, made once from the passphrase of .env
if [ -f config/packages/league_oauth2_server.yaml ] && [ ! -f config/jwt/private.pem ]; then
    passphrase=$(grep '^OAUTH_PASSPHRASE=' .env | cut -d= -f2)
    mkdir -p config/jwt
    openssl genrsa -aes128 -passout "pass:$passphrase" -out config/jwt/private.pem 4096 2>/dev/null
    openssl rsa -passin "pass:$passphrase" -in config/jwt/private.pem -pubout -out config/jwt/public.pem 2>/dev/null
fi

if bin/adminconsole list app --raw 2>/dev/null | grep -q '^app:import-catalogue'; then
    bin/adminconsole app:import-catalogue
    # the search schema is built from the filterable attributes when the container is compiled
    bin/adminconsole cache:clear
    bin/websiteconsole cache:clear
    bin/adminconsole cmsig:seal:reindex --index website --drop
fi
if bin/adminconsole list app --raw 2>/dev/null | grep -q '^app:create-ai-editor'; then bin/adminconsole app:create-ai-editor; fi
