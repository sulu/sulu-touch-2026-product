<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block meta %}
        {{ include('@SuluWebsite/Extension/seo.html.twig', {
            seo: extension.seo|default([]),
            content: content|default([]),
            localizations: localizations|default([]),
            shadowBaseLocale: shadowBaseLocale|default(),
        }) }}
    {% endblock %}

    {% block style %}{% endblock %}
    {{ importmap('app') }}
</head>
<body class="min-h-screen flex flex-col">
    <header class="border-b border-brand-100 bg-white/80 backdrop-blur">
        {% block header %}
            <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
                <a href="{{ sulu_content_root_path() }}" class="flex items-center gap-2 text-xl font-bold tracking-tight text-brand-900">
                    {{ include('_gem.html.twig', {class: 'h-6'}) }} Sulu Touch Shop
                </a>

                <ul class="flex items-center gap-6 text-sm font-medium">
                    {% for item in sulu_page_navigation_root_tree('main', 1, {
                        title: 'title',
                        url: 'url',
                    }) %}
                        <li>
                            <a href="{{ sulu_content_path(item.url) }}" class="hover:text-brand-500">{{ item.title }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endblock %}
    </header>

    <main class="flex-1">
        {% block content %}{% endblock %}
    </main>

    <footer class="border-t border-brand-100 py-8 text-center text-sm text-brand-700">
        {% block footer %}
            Sulu Touch 2026 demo shop, built on the Sulu product bundle.
        {% endblock %}
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>
