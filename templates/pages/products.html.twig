{% extends 'base.html.twig' %}

{% block content %}
    {% set query = app.request.query.all %}

    <div class="mx-auto max-w-6xl px-6 py-12" data-controller="catalogue-filter">
        <h1 class="text-4xl font-bold tracking-tight">{{ content.title }}</h1>
        <div class="mt-3 max-w-2xl text-brand-900/80">{{ content.introduction|default('')|raw }}</div>

        <form method="get" class="mt-8 grid gap-10 lg:grid-cols-[16rem_1fr]" data-catalogue-filter-target="form">
            <aside class="space-y-6">
                <input type="search" name="q" value="{{ catalogue.term }}" placeholder="Search products" data-action="change->catalogue-filter#submit"
                       class="w-full rounded-xl bg-white px-4 py-2 ring-1 ring-brand-200 focus:ring-brand-500 focus:outline-none">

                {% for filter in catalogue.filters %}
                    <fieldset>
                        <legend class="text-sm font-semibold uppercase tracking-widest text-brand-600">{{ filter.label }}</legend>
                        {% for option in filter.options %}
                            <label class="mt-2 flex items-center gap-2 text-sm">
                                <input type="checkbox" name="{{ filter.name }}[]" value="{{ option.value }}" {{ option.checked ? 'checked' }}
                                       data-action="change->catalogue-filter#submit" class="accent-brand-600">
                                {{ option.label }}
                            </label>
                        {% endfor %}
                    </fieldset>
                {% endfor %}

                <a href="?" class="inline-block text-sm text-clay underline">Reset filters</a>
            </aside>

            <section>
                <p class="mb-4 text-sm text-brand-700">{{ catalogue.total }} products</p>

                <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
                    {% for item in catalogue.items %}
                        {% include 'products/_card.html.twig' %}
                    {% else %}
                        <p class="col-span-full text-brand-700">Nothing found. Try fewer filters.</p>
                    {% endfor %}
                </div>

                {% if catalogue.pages > 1 %}
                    <nav class="mt-8 flex flex-wrap gap-2">
                        {% for number in 1..catalogue.pages %}
                            <a href="?{{ query|merge({p: number})|url_encode }}"
                               class="rounded-lg px-3 py-1.5 text-sm ring-1 {{ number == catalogue.page ? 'bg-brand-600 text-white ring-brand-600' : 'bg-white ring-brand-200' }}">{{ number }}</a>
                        {% endfor %}
                    </nav>
                {% endif %}
            </section>
        </form>
    </div>
{% endblock %}
