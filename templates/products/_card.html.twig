{# One product as a card: `item` has headline, claim, image and url. #}
{% set url = item.url|default((item.variants|default([])|first).url|default(null)) %}
<a href="{{ url ? sulu_content_path(url) : '#' }}"
   class="group block overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-brand-100 transition hover:shadow-md">
    {{ include('products/_image.html.twig', {image: item.image|default(null), format: 'product-card', alt: item.headline, class: 'aspect-square w-full object-cover transition group-hover:scale-105'}) }}
    <div class="p-4">
        <h3 class="font-semibold">{{ item.headline }}</h3>
        {% if item.claim|default %}<p class="mt-1 text-sm text-brand-700">{{ item.claim }}</p>{% endif %}
    </div>
</a>
